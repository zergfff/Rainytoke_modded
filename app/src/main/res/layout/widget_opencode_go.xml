<?xml version="1.0" encoding="utf-8"?>
<!-- MIUI Widget 布局规范：根布局必须为 FrameLayout + @android:id/background -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

    <!-- 时间行上方弹性空白 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 时钟/日期/星期/天气行（时间 35sp，其余 30sp，底边对齐） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="#FF85A2"
                android:textSize="50sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/widget_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon"
                android:textColor="#8A7A82"
                android:textSize="20sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08/28"
                android:textColor="#8A7A82"
                android:textSize="20sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_weather"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀️ 25°C"
                android:textColor="#8A7A82"
                android:textSize="20sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="end|bottom" />

    </LinearLayout>

    <!-- 时间行下方弹性空白 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 服务标题 + 更新时间 + 刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="22dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_opencode_go_logo"
            android:contentDescription="OpenCode Go"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_service_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title_opencode"
            android:textColor="#8A7A82"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="--"
            android:textColor="#C4A0AB"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="↻"
            android:textColor="#FF85A2"
            android:textSize="20sp"
            android:layout_marginStart="6dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- 5h -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <TextView android:id="@+id/row1_label"
            android:layout_width="wrap_content"
            android:minWidth="30dp"
            android:layout_marginEnd="4dp" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:text="5h" android:textColor="#8A7A82" android:textSize="12sp" />

        <TextView android:id="@+id/row1_pct"
            android:layout_width="wrap_content"
            android:minWidth="26dp" android:layout_height="wrap_content"
            android:text="--" android:textColor="#3D2C35" android:textSize="13sp"
            android:textStyle="bold" android:gravity="end" />

        <ProgressBar android:id="@+id/row1_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp" android:layout_height="7dp"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" android:max="100" android:progress="0"
            android:progressTint="@color/widget_bar_5h" />

        <TextView android:id="@+id/row1_reset"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_marginStart="4dp" android:layout_height="wrap_content"
            android:text="--" android:textColor="#B0A0A7" android:textSize="11sp" />
    </LinearLayout>

    <!-- 本周 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <TextView android:id="@+id/row2_label"
            android:layout_width="wrap_content"
            android:minWidth="30dp"
            android:layout_marginEnd="4dp" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:text="@string/window_weekly" android:textColor="#8A7A82" android:textSize="12sp" />

        <TextView android:id="@+id/row2_pct"
            android:layout_width="wrap_content"
            android:minWidth="26dp" android:layout_height="wrap_content"
            android:text="--" android:textColor="#3D2C35" android:textSize="13sp"
            android:textStyle="bold" android:gravity="end" />

        <ProgressBar android:id="@+id/row2_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp" android:layout_height="7dp"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" android:max="100" android:progress="0"
            android:progressTint="@color/widget_bar_weekly" />

        <TextView android:id="@+id/row2_reset"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_marginStart="4dp" android:layout_height="wrap_content"
            android:text="--" android:textColor="#B0A0A7" android:textSize="11sp" />
    </LinearLayout>

    <!-- 本月 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <TextView android:id="@+id/row3_label"
            android:layout_width="wrap_content"
            android:minWidth="30dp"
            android:layout_marginEnd="4dp" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:text="@string/window_monthly" android:textColor="#8A7A82" android:textSize="12sp" />

        <TextView android:id="@+id/row3_pct"
            android:layout_width="wrap_content"
            android:minWidth="26dp" android:layout_height="wrap_content"
            android:text="--" android:textColor="#3D2C35" android:textSize="13sp"
            android:textStyle="bold" android:gravity="end" />

        <ProgressBar android:id="@+id/row3_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp" android:layout_height="7dp"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" android:max="100" android:progress="0"
            android:progressTint="@color/widget_bar_monthly" />

        <TextView android:id="@+id/row3_reset"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_marginStart="4dp" android:layout_height="wrap_content"
            android:text="--" android:textColor="#B0A0A7" android:textSize="11sp" />
    </LinearLayout>

    <!-- DeepSeek 余额 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:src="@drawable/ic_deepseek_logo"
            android:contentDescription="DeepSeek"
            android:adjustViewBounds="true"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_ds_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_deepseek_balance"
            android:textColor="#8A7A82"
            android:textSize="11sp" />

        <TextView
                        android:id="@+id/widget_ds_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="#3D2C35"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 最下方弹性空白（第 3 个） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        </FrameLayout>