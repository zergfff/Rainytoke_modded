<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 引导用户关闭电池优化，保证小组件周期性后台刷新不被系统推迟 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- HyperOS 3 系统应用查询（WidgetIntentHelper 跳转用） -->
    <queries>
        <package android:name="com.android.deskclock" />
        <package android:name="com.android.calendar" />
        <package android:name="com.miui.weather2" />
    </queries>

    <application
        android:name=".RainyTokenApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RainyToken"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <!--
        应用已实现 Configuration.Provider（on-demand 初始化），必须完全移除
        androidx.startup 的 InitializationProvider，否则 WorkManager 会走默认
        初始化路径、忽略我们设置的 HiltWorkerFactory，导致 @HiltWorker 无法
        实例化（报 NoSuchMethodException: <init>[Context, WorkerParameters]）。

        注意：只移除 WorkManagerInitializer 这个 meta-data 是不够的，
        merger 不会真正去掉初始化器；必须移除整个 provider。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RainyToken">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件：后台刷新接收器（主进程，需要 Hilt DI） -->
        <receiver
            android:name=".ui.widget.WidgetRefreshReceiver"
            android:exported="false" />

        <!-- 时钟每分钟更新接收器 -->
        <receiver
            android:name=".ui.widget.WidgetTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_TICK" />
            </intent-filter>
        </receiver>

        <!-- OpenCode Go 小组件（MIUI Widget） -->
        <receiver
            android:name=".ui.widget.OpenCodeGoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <!-- 标准 Android 定时刷新 -->
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- MIUI 曝光刷新（划到负一屏/桌面时触发） -->
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_opencode_go_info" />
            <!--
              MIUI 小部件专属标识（miuiWidget / miuiWidgetRefresh /
              miuiWidgetRefreshMinInterval / miuiWidgetVersion）已移除。

              原因：一旦声明 miuiWidget=true，MIUI 只把小部件当作「小米小部件」，
              并且按 miuiWidgetVersion 去小米小部件平台匹配已审核条目；本 APP 是自编译
              APK，平台侧没有对应版本的条目，于是小部件中心里**整个 APP 都不出现**
              （实测三处入口全空：系统小部件管理器 / 长按图标 / APP 内 +）。

              去掉这些标识后退回「普通 Android 小组件」：MIUI 会把它放进原生组件列表，
              一定能被列出。代价是失去曝光刷新，改由 updatePeriodMillis（30 分钟）
              + WidgetPeriodicWorker（15 分钟）驱动刷新。
            -->
        </receiver>

    </application>

</manifest>
